<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AndroidBatteryWidget" parent="Theme.MaterialComponents.DayNight">
        <item name="colorPrimary">@color/ui_primary</item>
        <item name="colorPrimaryVariant">@color/ui_primary</item>
        <item name="colorOnPrimary">@color/ui_on_primary</item>
        <item name="colorSecondary">@color/ui_primary</item>
        <item name="colorOnSecondary">@color/ui_on_primary</item>
        <item name="colorSurface">@color/ui_surface</item>
        <item name="colorOnSurface">@color/ui_text</item>
        <item name="android:colorBackground">@color/ui_background</item>
        <item name="android:windowBackground">@color/ui_background</item>
        <item name="android:textColorPrimary">@color/ui_text</item>
        <item name="android:textColorSecondary">@color/ui_text_secondary</item>
        <item name="android:statusBarColor">@color/ui_background</item>
        <item name="android:navigationBarColor">@color/ui_background</item>
        <item name="colorControlNormal">@color/ui_text_secondary</item>
        <item name="actionBarStyle">@style/Widget.Battery.ActionBar</item>
        <item name="materialCardViewStyle">@style/Widget.Battery.Card</item>
        <item name="materialButtonStyle">@style/Widget.Battery.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Battery.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.Battery.Button.Text</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Battery.Body</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Battery.Caption</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.Battery.Section</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowEnterTransition">@android:transition/fade</item>
        <item name="android:windowExitTransition">@android:transition/fade</item>
    </style>

    <style name="Theme.AndroidBatteryWidget.AppWidgetContainerParent" parent="@android:style/Theme.DeviceDefault">
        <!-- Radius of the outer bound of widgets to make the rounded corners -->
        <item name="appWidgetRadius">16dp</item>
        <!--
        Radius of the inner view's bound of widgets to make the rounded corners.
        It needs to be 8dp or less than the value of appWidgetRadius
        -->
        <item name="appWidgetInnerRadius">16dp</item>
    </style>

    <style name="Theme.AndroidBatteryWidget.AppWidgetContainer" parent="Theme.AndroidBatteryWidget.AppWidgetContainerParent">
        <!-- Apply padding to avoid the content of the widget colliding with the rounded corners -->
        <item name="appWidgetPadding">2dp</item>
        <item name="android:background">@android:color/transparent</item>

    </style>

    <style name="Theme.AndroidBatteryWidget.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.AndroidBatteryWidget.AnimBase" parent="Theme.AndroidBatteryWidget">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <!--Android 5.x开始需要把颜色设置透明，否则导航栏会呈现系统默认的浅灰色-->
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.AndroidBatteryWidget.Anim" parent="Theme.AndroidBatteryWidget.AnimBase" />

    <style name="Theme.AndroidBatteryWidget.AppBarOverlay" parent="ThemeOverlay.AppCompat" />

    <style name="Theme.AndroidBatteryWidget.PopupOverlay" parent="ThemeOverlay.AppCompat" />

    <style name="ToolBarStyle" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="android:itemBackground">#fff</item>
        <item name="android:textColor">#333</item>
    </style>
</resources>

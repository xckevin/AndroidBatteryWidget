<resources>
    <color name="ui_background">#F3F7F5</color>
    <color name="ui_surface">#FFFFFF</color>
    <color name="ui_primary">#147D64</color>
    <color name="ui_on_primary">#FFFFFF</color>
    <color name="ui_primary_container">#E1F2EA</color>
    <color name="ui_text">#142C27</color>
    <color name="ui_text_secondary">#536B65</color>
    <color name="ui_outline">#DCE6E2</color>

    <style name="TextAppearance.Battery.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ui_text</item>
    </style>
    <style name="TextAppearance.Battery.Section" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ui_text</item>
    </style>
    <style name="TextAppearance.Battery.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ui_text_secondary</item>
    </style>
    <style name="TextAppearance.Battery.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ui_text_secondary</item>
    </style>
    <style name="TextAppearance.Battery.Toolbar" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ui_text</item>
    </style>
    <style name="Widget.Battery.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/ui_surface</item>
        <item name="strokeColor">@color/ui_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.Battery.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.Battery.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="strokeColor">@color/ui_outline</item>
    </style>
    <style name="Widget.Battery.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Widget.Battery.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/ui_background</item>
        <item name="elevation">0dp</item>
        <item name="titleTextStyle">@style/TextAppearance.Battery.Toolbar</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Battery.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <FrameLayout
            android:id="@+id/id_device_icon_container"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/device_ui_icon_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="12dp"
                app:tint="@color/ui_primary"
                tools:src="@drawable/ic_bluetoothon" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/state"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="end|top"
                android:background="@color/bt_state_unconnected"
                android:contentDescription="@null"
                app:shapeAppearance="@style/roundedCornerStyle" />
        </FrameLayout>

        <TextView
            android:id="@+id/level"
            style="@style/TextAppearance.Battery.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:gravity="end"
            android:maxEms="5"
            android:maxLines="1"
            android:textColor="@color/ui_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/id_device_icon_container"
            tools:text="82%" />

        <TextView
            android:id="@+id/name"
            style="@style/TextAppearance.Battery.Section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ui_text"
            app:layout_constraintEnd_toStartOf="@id/level"
            app:layout_constraintStart_toEndOf="@id/id_device_icon_container"
            app:layout_constraintTop_toTopOf="@id/id_device_icon_container"
            tools:text="Wireless headphones" />

        <TextView
            android:id="@+id/status"
            style="@style/TextAppearance.Battery.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ui_text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/id_device_icon_container"
            app:layout_constraintTop_toBottomOf="@id/name"
            tools:text="Connected" />

        <TextView
            android:id="@+id/type"
            style="@style/TextAppearance.Battery.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ui_text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/id_device_icon_container"
            tools:text="Headphones · System reading" />

        <TextView
            android:id="@+id/freshness"
            style="@style/TextAppearance.Battery.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ui_text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/type"
            tools:text="System reading · checked just now" />

        <CheckBox
            android:id="@+id/checkbox"
            style="@style/TextAppearance.Battery.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="@string/device_show_in_widget"
            android:textColor="@color/ui_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/freshness" />

        <View
            android:id="@+id/id_device_actions_divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/ui_outline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/checkbox" />

        <TextView
            android:id="@+id/id_device_actions_label"
            style="@style/TextAppearance.Battery.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/device_ui_manage_label"
            android:textColor="@color/ui_text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/id_device_actions_divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rename"
            style="@style/Widget.Battery.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:minWidth="0dp"
            android:text="@string/device_rename"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/id_device_actions_label" />

        <LinearLayout
            android:id="@+id/id_device_order_actions"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rename">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/move_up"
                style="@style/Widget.Battery.Button.Text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/device_move_up" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/move_down"
                style="@style/Widget.Battery.Button.Text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/device_move_down" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

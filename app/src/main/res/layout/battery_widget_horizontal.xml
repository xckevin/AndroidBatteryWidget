<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.AndroidBatteryWidget.AppWidget.Container"
    android:id="@+id/battery_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:theme="@style/Theme.AndroidBatteryWidget.AppWidgetContainer">

    <RelativeLayout
        android:id="@+id/phone_area"
        style="@style/Widget.AndroidBatteryWidget.AppWidget.InnerView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/appwidget_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:src="@drawable/single_widget_preview" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/widget_devices_container_widget"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <!-- Used only when exactly one device is selected. Its bounds intentionally mirror phone_area. -->
        <RelativeLayout
            android:id="@+id/widget_single_device_area"
            style="@style/Widget.AndroidBatteryWidget.AppWidget.InnerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_single_device_indicator"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:src="@drawable/single_widget_preview" />
        </RelativeLayout>
        <GridView
            android:id="@+id/widget_devices"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnWidth="72dp"
            android:gravity="center"
            android:numColumns="auto_fit"
            android:stretchMode="columnWidth" />
        <TextView
            android:id="@+id/widget_devices_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_no_devices" />
        <TextView
            android:id="@+id/widget_preview_devices"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

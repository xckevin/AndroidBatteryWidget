<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ui_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="20dp" android:paddingEnd="20dp" android:paddingBottom="28dp">
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Battery.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/settings_ui_phone_section_title" android:textAppearance="@style/TextAppearance.Battery.Section" android:textColor="@color/ui_text" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/phoneAlertSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/alert_phone_switch" android:textAppearance="@style/TextAppearance.Battery.Body" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/alert_phone_summary" android:textAppearance="@style/TextAppearance.Battery.Caption" android:textColor="@color/ui_text_secondary" />
                <LinearLayout android:id="@+id/phoneOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
                    <RadioGroup android:id="@+id/phoneThresholdGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <RadioButton android:id="@+id/phoneThreshold80" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/alert_threshold_80" />
                        <RadioButton android:id="@+id/phoneThreshold100" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/alert_threshold_100" />
                        <RadioButton android:id="@+id/phoneThresholdCustom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/alert_threshold_custom" />
                    </RadioGroup>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/phoneCustomThresholdLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/alert_custom_threshold_hint">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/phoneCustomThreshold" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Battery.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/settings_ui_bluetooth_section_title" android:textAppearance="@style/TextAppearance.Battery.Section" android:textColor="@color/ui_text" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/bluetoothAlertSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/alert_bluetooth_switch" android:textAppearance="@style/TextAppearance.Battery.Body" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/alert_bluetooth_summary" android:textAppearance="@style/TextAppearance.Battery.Caption" android:textColor="@color/ui_text_secondary" />
                <LinearLayout android:id="@+id/bluetoothOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/bluetoothThresholdLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/alert_bluetooth_threshold_hint">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/bluetoothThreshold" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/alert_select_devices" android:textAppearance="@style/TextAppearance.Battery.Body" android:textColor="@color/ui_text" />
                    <TextView android:id="@+id/bluetoothEmptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/alert_no_bluetooth_devices" android:textAppearance="@style/TextAppearance.Battery.Caption" android:textColor="@color/ui_text_secondary" />
                    <LinearLayout android:id="@+id/bluetoothDeviceList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Battery.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/settings_ui_quiet_section_title" android:textAppearance="@style/TextAppearance.Battery.Section" android:textColor="@color/ui_text" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/quietHoursSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/alert_quiet_hours_switch" android:textAppearance="@style/TextAppearance.Battery.Body" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/alert_quiet_hours_summary" android:textAppearance="@style/TextAppearance.Battery.Caption" android:textColor="@color/ui_text_secondary" />
                <LinearLayout android:id="@+id/quietHoursOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/quietStartButton" style="@style/Widget.Battery.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/alert_quiet_start" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/quietEndButton" style="@style/Widget.Battery.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/alert_quiet_end" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:accessibilityHeading="true" android:text="@string/settings_ui_readiness_title" android:textAppearance="@style/TextAppearance.Battery.Section" android:textColor="@color/ui_text" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/notificationStatusCard" style="@style/Widget.Battery.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/settings_ui_notification_access_title" android:textAppearance="@style/TextAppearance.Battery.Section" android:textColor="@color/ui_text" />
                <TextView android:id="@+id/notificationStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAppearance="@style/TextAppearance.Battery.Body" android:textColor="@color/ui_text_secondary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/notificationSettingsButton" style="@style/Widget.Battery.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/alert_open_notification_settings" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/monitoringStatusCard" style="@style/Widget.Battery.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/settings_ui_monitoring_title" android:textAppearance="@style/TextAppearance.Battery.Section" android:textColor="@color/ui_text" />
                <TextView android:id="@+id/monitoringStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAppearance="@style/TextAppearance.Battery.Body" android:textColor="@color/ui_text_secondary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/monitoringSettingsButton" style="@style/Widget.Battery.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/alert_open_monitoring_settings" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/saveAlertsButton" style="@style/Widget.Battery.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/alert_save" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>